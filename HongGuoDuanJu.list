host-suffix, ad.pangle.cn, reject
host-suffix, ad.pangolin.cn, reject
host-keyword, ad-union-sdk, reject

# 字节系广告与配置兜底
host-keyword, be-pack, reject
host-suffix, zijieapi.com, reject
host-keyword, tnc.snssdk, reject

