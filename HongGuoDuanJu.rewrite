# 红果短剧 去广告 · 重写规则 v1.1（Quantumult X）
# 仓库：https://github.com/zhizhuo78911/zhumy78911-QuantumultX
# 用法：Quantumult X → 重写 → 引用 → 右上角 + → 填本文件 raw 地址
# 纯 URL 规则：不调用任何外部脚本、不下载任何文件，所以不会出现 404
# 前提：需要安装并信任 MITM 证书 + 打开「MITM 解密」，否则本文件不生效

# ==================== 一、穿山甲广告 SDK 接口：回空，让 SDK 认为无广告可投 ====================
# 申请广告位
^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/get_ads url reject-dict
# 竞价预取
^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/server_bidding\/pre_fetch url reject-200
# 广告位配置
^https?:\/\/api-access\.pangolin-sdk-toutiao\.com\/api\/ad\/union\/sdk\/settings url reject-dict

# ==================== 二、穿山甲广告素材 / 渲染器 / 安装包 ====================
# 广告渲染器（H5 样式模板）
^https?:\/\/[^\/]*pglstatp-toutiao\.com\/(.+\/)?ad-pattern\/renderer url reject-200
# 广告视频素材
^https?:\/\/[^\/]*pglstatp-toutiao\.com\/.+\.mp4 url reject
# 广告落地页 APK 安装包
^https?:\/\/[^\/]*pglstatp-toutiao\.com\/(obj|img)\/ad-app-package\/ url reject
^https?:\/\/[^\/]*pstatp\.com\/(obj|img)\/(ad-app-package|ad)\/ url reject
^https?:\/\/[^\/]*byteimg\.com\/(ad-app-package|obj\/ad)\/ url reject

# ==================== 三、红果自有广告接口 ====================
^https?:\/\/[^\/]*hongguoapp\.com\/.*\/(ad|ads|advert|advertise)\/ url reject-dict
^https?:\/\/[^\/]*hongguosdk\.com\/ url reject-dict

# ==================== 四、番茄系接口里带 /ad/ 路径的广告请求 ====================
# 只命中路径段为 /ad/ /ads/ /advert/ 的接口，不会碰 /reading/ 正文接口
^https?:\/\/[^\/]*\.fqnovel\.com\/.*\/(ad|ads|advert|advertise)\/ url reject-dict

# ==================== 五、电商广告落地页 ====================
^https?:\/\/adim\.pinduoduo\.com\/ url reject

# ==================== 六、MITM 解密主机名 ====================
# 只解密上面规则用到的主机；被分流 reject 的域名不需要写进来
hostname = *.fqnovel.com, api-access.pangolin-sdk-toutiao.com, *.pglstatp-toutiao.com, *.hongguoapp.com, *.hongguosdk.com

# ==================== 附：可选增强（默认关闭，不会触发任何下载） ====================
# 下面这一行是「接口响应清理」增强项，需要你自己把 hongguo-ad.js 传到仓库根目录、
# 并把地址改成你自己的 raw 链接后，再删除行首的 # 才生效。
# 不删除注释就完全不会执行，也就不会有 404。
# ^https?:\/\/[^\/]+\.fqnovel\.com\/reading\/ url script-response-body https://raw.githubusercontent.com/zhizhuo78911/zhumy78911-QuantumultX/main/hongguo-ad.js
