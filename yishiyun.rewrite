; ============================================================
; 易视云 EseeCloud 去广告 — Quantumult X 重写规则 (Rewrite)
; 依据 2026-11-22 QX 1.9.0 实际抓包逐条核对生成
; 资源类型：Rewrite（重写）  是否需要 MITM：需要（本文件已自带 [mitm] 段）
; 作用：按“具体接口路径”拦截，专治共享 CDN 上的广告，
;       因此不会像整域拦截那样把抖音 / 美团 / 爱奇艺误伤
; ============================================================

[rewrite_local]

; —— 易视云 App 内自带广告位接口 ——
; 广告位下发（抓包 /app_adv/adv，返回 count/list 即广告列表）
url ^https?://openapi\.dvr163\.com/app_adv/ reject
; 第三方广告 SDK 相关接口（抓包 /NewAppApi/ThirdAdAppApi/adExposureRatioControl 广告曝光比例控制）
url ^https?://openapi\.dvr163\.com/NewAppApi/ThirdAdAppApi/ reject

; —— 运营推广位（首页弹窗/Banner 推送，拦掉只影响推广内容）——
; 若发现某个正常功能入口一起消失，删除本行即可
url ^https?://openapi\.dvr163\.com/NewAppApi/OperationSlotApi/getOperationSlotList reject

; —— 共享 CDN 上的广告素材与推广落地页（只拦广告专用路径）——
; 美团增长营销广告组件（com.sankuai.fe.growth 推广页 + growth-adaptor 广告适配脚本）
url ^https?://[^/]*\.meituan\.net/static-prod01/com\.sankuai\.fe\.growth reject
url ^https?://[^/]*\.meituan\.net/[^/]*growth-adaptor reject
; 易视云内美团广告位素材目录
url ^https?://[^/]*\.meituan\.net/(growthyxdx|xianfu|aigchub|evapicture|bizhorus)/ reject
; 美团推广接口（/prom/ = promotion）
url ^https?://apimobile\.meituan\.com/prom/ reject
; 巨量引擎可玩广告组件（同域还承载抖音电商资源，故只按 /obj/static/ad/ 路径拦）
url ^https?://lf-cdn-tos\.bytescm\.com/obj/static/ad/ reject
; 第三方广告 SDK 远程配置（阿里 OSS 共享域，只拦这一个配置文件，禁止整域拦截）
url ^https?://jt-sdk-ios\.oss-cn-beijing\.aliyuncs\.com/iOSConfig\.txt reject

[mitm]
hostname = openapi.dvr163.com, *.meituan.net, lf-cdn-tos.bytescm.com, jt-sdk-ios.oss-cn-beijing.aliyuncs.com
